# Browser requests use the same origin; Vite forwards them to this backend.
API_PROXY_TARGET=http://127.0.0.1:8080
# Set only when the API is hosted at a separate origin (configure CORS there).
VITE_API_BASE_URL=

# Optional. Defaults work without API keys. Use "off" to disable either service.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors
# Photon-compatible geocoder; only explicit address searches, no autocomplete.
VITE_GEOCODER_URL=https://photon.komoot.io/api/
