DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
LOG_LEVEL=INFO
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432
APP_PORT=8080
FRONTEND_PORT=5173

JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
CORS_ORIGINS=[]
MODE="normal"

# Сгенерируйте свой ключ: openssl rand -hex 64
JWT_SECRET_KEY=

# Необязательно для локального запуска: если пусто, пароль сгенерируется
# при первом создании admin и будет выведен в логах сервиса migrate.
ADMIN_PASSWORD=
